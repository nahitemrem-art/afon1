{
  "name": "tefas-tracker",
  "version": "1.0.0",
  "description": "TEFAS funds tracking application for web and Android",
  "private": true,
  "workspaces": [
    "backend",
    "mobile",
    "shared"
  ],
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../mobile && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:mobile\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "build": "npm run build:backend",
    "build:backend": "cd backend && npm run build",
    "start": "cd backend && npm start"
  },
  "keywords": [
    "tefas",
    "funds",
    "investment",
    "portfolio",
    "react-native",
    "expo",
    "android",
    "web"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

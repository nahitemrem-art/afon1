{
  "name": "fund-management-app",
  "version": "1.0.0",
  "description": "Fund management application with web and mobile clients",
  "private": true,
  "scripts": {
    "install:all": "npm run install:shared && npm run install:web && npm run install:mobile",
    "install:shared": "cd packages/shared && npm install",
    "install:web": "cd web-client && npm install",
    "install:mobile": "cd mobile-client && npm install",
    "build:shared": "cd packages/shared && npm run build",
    "dev:web": "cd web-client && npm run dev",
    "dev:mobile": "cd mobile-client && npm start",
    "build:web": "cd web-client && npm run build",
    "preview:web": "cd web-client && npm run preview"
  },
  "keywords": [
    "fund-management",
    "portfolio",
    "react",
    "expo",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
